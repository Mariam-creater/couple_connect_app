APP_NAME="Couple Connect"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://couple-connect-backend.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database (MySQL on Render, Aiven, PlanetScale, or Supabase)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=couple_connect
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Real-Time WebSockets via Pusher (Free Tier Cloud Cluster)
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_SCHEME=https
PUSHER_PORT=443

# Persistent Media Storage via Cloudflare R2 / AWS S3
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=couple-connect-media
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_URL=https://media.yourdomain.com

QUEUE_CONNECTION=database
CACHE_STORE=database

RUN_MIGRATIONS=true
